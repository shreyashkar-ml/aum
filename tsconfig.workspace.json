{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "customConditions": [
      "development"
    ]
  },
  "include": [
    "src/**/*.ts",
    "packages/**/*.ts",
    "apps/**/*.ts",
    "checks/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist"
  ]
}
